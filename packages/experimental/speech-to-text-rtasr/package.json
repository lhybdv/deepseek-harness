{
  "name": "@deepseek-ai/dsh-experimental-speech-to-text-rtasr",
  "description": "iFlytek RTASR cloud transcription over a signed WebSocket session",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/speech-to-text-rtasr"
  },
  "type": "module",
  "main": "lib/index.js",
